# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔒 Production Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Server
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/scc_dp
MONGO_POOL_SIZE=20
MONGO_TIMEOUT=10000

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_DB=0
CACHE_TTL=3600

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRE=30d

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PRODUCTION_URL=https://yourdomain.com

# ML Services
NLP_SERVICE_URL=http://localhost:8001
LSTM_SERVICE_URL=http://localhost:8002
RISK_ENGINE_URL=http://localhost:8003
ML_SERVICE_TIMEOUT=10000

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@sccadp.com

# Security
BCRYPT_ROUNDS=12
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# AWS (optional for image storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=scc-dp-uploads

# Monitoring
SENTRY_DSN=https://your-sentry-dsn
ANALYTICS_ENABLED=true

# API
API_VERSION=v1
API_BASE_URL=/api/v1
